PORT=8787
CORS_ORIGIN=http://localhost:8000

# Supabase — Project Settings > API no painel do seu projeto.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=copie-a-anon-ou-publishable-key-aqui
# NUNCA exponha essa chave no front-end nem a commite — ela ignora RLS por completo.
SUPABASE_SERVICE_ROLE_KEY=copie-a-service-role-key-aqui

# Para onde o e-mail de "esqueci minha senha" do Supabase deve levar o usuário
# depois de clicar no link (uma página do seu site que lê o token da URL).
PASSWORD_RESET_REDIRECT_URL=http://localhost:8000/redefinir-senha.html

# Para onde o e-mail de confirmação de cadastro deve levar o usuário depois
# de clicar no link (a tela de login do seu site).
EMAIL_CONFIRM_REDIRECT_URL=http://localhost:8000/index.html?login=1

# Mercado Pago — Suas integrações > Credenciais, no painel do Mercado Pago.
# Sem essa chave, o checkout PIX roda em modo simulado (não processa dinheiro real).
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
